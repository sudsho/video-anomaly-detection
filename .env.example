# Path to YAML config inside the container or runtime
VAD_CONFIG=configs/default.yaml

# Path to checkpoint file
VAD_CKPT=checkpoints/model.pt

# AWS region for the inference deployment (sagemaker / ec2 / ecs)
AWS_REGION=us-east-1

# S3 bucket where checkpoints + sample videos live
S3_BUCKET=video-anomaly-artifacts

# Optional triton inference server target (host:port). leave empty to use local pytorch.
TRITON_URL=

# Frame-AUC threshold above which a clip triggers an alert (0..1 for clf, MSE for AE)
ALERT_THRESHOLD=0.6
